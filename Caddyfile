{
	auto_https disable_redirects
	skip_install_trust
	default_sni {$LAN_IP}
}

https://{$LAN_IP}:{$WEB_PORT}, https://{$PI_HOSTNAME}.local:{$WEB_PORT}, https://localhost:{$WEB_PORT} {
	tls internal
	# Cabeceras de seguridad del panel. Sin HSTS a propósito: el certificado es propio (CA interna)
	# y con HSTS el navegador no dejaría saltar su aviso.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
	reverse_proxy wg-easy:51821
}
