# HEIMDALL - variables de configuración
# install.sh crea .env a partir de este archivo y rellena lo que falte automáticamente.
# OJO: WG_ADMIN_*, WG_HOST, WG_PORT y WG_DNS solo se aplican la PRIMERA vez que arranca.
# Después se cambian desde la web (Administración) o borrando data/wireguard para empezar de cero.

TZ=Europe/Madrid

# Usuario y contraseña del panel web (install.sh genera la contraseña si está vacía)
WG_ADMIN_USER=admin
WG_ADMIN_PASSWORD=

# Dirección pública a la que se conectan los dispositivos desde fuera de casa.
# Vacío = install.sh usa tu subdominio de DuckDNS (si lo configuras abajo) o tu IP pública actual.
WG_HOST=

# Puerto UDP de WireGuard. Debes redirigirlo en el router hacia la IP de la Raspberry Pi.
WG_PORT=51820

# DNS que usarán los dispositivos conectados a la VPN.
# Vacío = install.sh usa la Raspberry Pi si SHIELD-DNS está instalado (bloqueo de publicidad),
# y si no, 1.1.1.1.
WG_DNS=

# Panel web (HTTPS con certificado autofirmado)
WEB_PORT=51843
LAN_IP=
PI_HOSTNAME=

# DNS dinámico gratuito con DuckDNS (opcional, recomendado si tu IP pública cambia).
# 1) Entra en https://www.duckdns.org, crea un subdominio y copia el token.
# 2) Rellena estas dos variables y vuelve a ejecutar ./install.sh
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
